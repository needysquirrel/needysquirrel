import { Component } from '@angular/core';

interface User {
  name: string;
  status: string;
  date: string;
}

@Component({
  selector: 'app-modal',
  templateUrl: './modal.component.html',
  styleUrls: ['./modal.component.css']
})
export class ModalComponent {
  isOpen = false;
  userInput = '';
  selectedUser: User | null = null;

  userList: User[] = [
    { name: 'John Doe', status: 'Active', date: '2025-05-01' },
    { name: 'Jane Smith', status: 'Inactive', date: '2025-04-15' },
    { name: 'Jake Johnson', status: 'Active', date: '2025-05-01' }
  ];

  filteredUsers: User[] = [];

  openModal() {
    this.isOpen = true;
    this.userInput = '';
    this.filteredUsers = [];
    this.selectedUser = null;
  }

  closeModal() {
    this.isOpen = false;
  }

  onInputChange() {
    const val = this.userInput.toLowerCase();
    this.filteredUsers = val
      ? this.userList.filter(u => u.name.toLowerCase().includes(val))
      : [];
    this.selectedUser = null;
  }

  selectUser(user: User) {
    this.userInput = user.name;
    this.selectedUser = user;
    this.filteredUsers = [];
  }
}

