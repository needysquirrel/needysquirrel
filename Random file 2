<!-- modal.component.html -->
<div class="modal" *ngIf="isOpen">
  <div class="modal-content">
    <span class="close-btn" (click)="closeModal()">&times;</span>
    <h3>User Info</h3>
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="autocomplete-container">
            <input
              type="text"
              [(ngModel)]="userInput"
              (input)="onInputChange()"
              name="user"
              autocomplete="off"
            />
            <div class="autocomplete-suggestions" *ngIf="filteredUsers.length">
              <div *ngFor="let user of filteredUsers" (click)="selectUser(user)">
                {{ user.name }}
              </div>
            </div>
          </td>
          <td>{{ selectedUser?.status || '-' }}</td>
          <td>{{ selectedUser?.date || '-' }}</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

